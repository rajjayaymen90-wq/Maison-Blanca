# Never prefix Stripe secrets with VITE_. No secret belongs in the browser.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Use your real HTTPS domain when deploying. No trailing slash.
SITE_URL=http://127.0.0.1:5173
VITE_SITE_URL=http://127.0.0.1:5173
# true = local simulated orders; false = Stripe serverless checkout.
VITE_DEMO_MODE=true
